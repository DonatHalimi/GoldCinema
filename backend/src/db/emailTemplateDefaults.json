        "required": true,
        "sampleValue": "28/07/2026"
      },
      {
        "key": "showtimeTime",
        "description": "Screening time.",
        "required": true,
        "sampleValue": "17:30"
      },
      {
        "key": "cinemaName",
        "description": "Cinema name.",
        "required": true,
        "sampleValue": "GoldCinema"
      },
      {
